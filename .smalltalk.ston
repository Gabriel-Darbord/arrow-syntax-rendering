SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'ArrowSyntaxRendering',
      #repository : 'tonel://src',
      #load : [ 'development' ],
      #ignoreImage : true,
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming,
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [
      'ArrowSyntaxRendering-Tests'
    ],
    #failOnZeroTests : true
  }
}
